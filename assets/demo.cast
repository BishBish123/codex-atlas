[39.24, "o", "# Codex-Atlas eval report\r\n"]
[39.28, "o", "\r\n"]
[39.32, "o", "## Headline\r\n"]
[39.36, "o", "\r\n"]
[39.4, "o", "| Metric | Value |\r\n"]
[39.44, "o", "| --- | ---: |\r\n"]
[39.48, "o", "| Questions | 30 |\r\n"]
[39.52, "o", "| Route correctness | 93.3% |\r\n"]
[39.56, "o", "| Citation recall (mean) | 0.13 |\r\n"]
[39.6, "o", "| Citation precision (mean) | 0.06 |\r\n"]
[39.64, "o", "| Faithfulness (mean) | 0.38 |\r\n"]
[39.68, "o", "| Faithfulness (RAGAS) | 0.38 |\r\n"]
[39.72, "o", "| Answer relevancy (RAGAS) | 0.14 |\r\n"]
[39.76, "o", "| Context precision (RAGAS) | 0.35 |\r\n"]
[39.8, "o", "| Context recall (RAGAS) | 0.35 |\r\n"]
