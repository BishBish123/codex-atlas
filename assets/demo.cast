[5.58, "o", "Route: structural (grade 1.00, attempts 1)\r\n"]
[5.63, "o", "                              who calls Agent.run                               \r\n"]
[5.68, "o", "\r\n"]
[5.73, "o", "codex_atlas.cli.eval_cmd._run (src/codex_atlas/cli.py:719-850)                  \r\n"]
[5.78, "o", "\r\n"]
[5.83, "o", "                                                                                \r\n"]
[5.88, "o", "     async def _run() -> None:  # noqa: PLR0912, PLR0915                        \r\n"]
[5.93, "o", "         encoder_obj = _resolve_encoder(encoder)                                \r\n"]
[5.98, "o", "         # If --rebuild-graph is set, parse the corpus and (re)write the        \r\n"]
[6.03, "o", "         # graph file BEFORE we try to load it. This is the explicit            \r\n"]
[6.08, "o", "         # opt-in that pairs with the actionable error below \u2014 users who        \r\n"]
[6.13, "o", "         # don't have a graph yet can run `atlas eval --rebuild-graph           \r\n"]
[6.18, "o", "         # --corpus src` instead of having to remember the two-step             \r\n"]
[6.23, "o", "         # `atlas index --skip-embed` invocation.                               \r\n"]
[6.28, "o", "         if rebuild_graph:                                                      \r\n"]
[6.33, "o", "             parsed = parsed_corpus_holder[0]  # validated above                \r\n"]
[6.38, "o", "             cg_built = CallGraph()                                             \r\n"]
[6.43, "o", "             cg_built.ingest(parsed)                                            \r\n"]
[6.48, "o", "             cg_built.save(graph)                                               \r\n"]
[6.53, "o", "             console.print(                                                     \r\n"]
[6.58, "o", "                 f\"[green]rebuilt[/] graph \"                                    \r\n"]
[6.63, "o", "                 f\"({cg_built.n_nodes} nodes, {cg_built.n_edges} edges) ->      \r\n"]
[6.68, "o", " {graph}\"                                                                       \r\n"]
[6.73, "o", "             )                                                                  \r\n"]
[6.78, "o", "         if not graph.exists():                                                 \r\n"]
[6.83, "o", "             _bail(                                                             \r\n"]
[6.88, "o", "                 f\"graph.json missing at {graph} \u2014 run \"                        \r\n"]
[6.93, "o", "                 f\"`atlas index --skip-embed --corpus <path>` first, or pass \"  \r\n"]
[6.98, "o", "                 f\"--rebuild-graph (with --corpus) to build it inline.\"         \r\n"]
[7.03, "o", "             )                                                                  \r\n"]
[7.08, "o", "         cg = CallGraph.load(graph)                                             \r\n"]
[7.13, "o", "         store: ChunkStoreProtocol                                              \r\n"]
[7.18, "o", "         if store_backend == \"memory\":                                          \r\n"]
[7.23, "o", "             # Dict-backed: rebuild the embedding index from `corpus` so        \r\n"]
[7.28, "o", "             # the harness stays hermetic. No DSN, no pgvector.                 \r\n"]
[7.33, "o", "             store = InMemoryChunkStore()                                       \r\n"]
[7.38, "o", "             await store.setup(dim=encoder_obj.dim)                             \r\n"]
[7.43, "o", "             parsed = parsed_corpus_holder[0]  # validated above                \r\n"]
[7.48, "o", "             chunks = [c for pf in parsed for c in pf.chunks]                   \r\n"]
[7.53, "o", "             if chunks:                                                         \r\n"]
[7.58, "o", "                 vectors = encoder_obj.encode([c.text for c in chunks])         \r\n"]
[7.63, "o", "                 await store.upsert_chunks(chunks, vectors)                     \r\n"]
[7.68, "o", "         elif store_backend == \"postgres\":                                      \r\n"]
[7.73, "o", "             store = ChunkStore(dsn=_dsn())                                     \r\n"]
[7.78, "o", "             await store.setup(dim=encoder_obj.dim)                             \r\n"]
[7.83, "o", "         else:                                                                  \r\n"]
[7.88, "o", "             _bail(f\"unknown --store value {store_backend!r} (expected:         \r\n"]
[7.93, "o", " postgres, memory)\")                                                            \r\n"]
[7.98, "o", "         retriever = Retriever(encoder_obj, store, cg,                          \r\n"]
[8.03, "o", " RetrieverConfig(top_k=8))                                                      \r\n"]
[8.08, "o", "         agent = Agent(retriever)                                               \r\n"]
[8.13, "o", "         questions = load_golden_set()                                          \r\n"]
[8.18, "o", "         try:                                                                   \r\n"]
[8.23, "o", "             active_judge = make_judge(mode=judge_mode)                         \r\n"]
[8.28, "o", "         except OSError as exc:                                                 \r\n"]
[8.33, "o", "             _bail(                                                             \r\n"]
[8.38, "o", "                 f\"--judge {judge_mode!r} requires an API key. \"                \r\n"]
[8.43, "o", "                 f\"Set ANTHROPIC_API_KEY or OPENAI_API_KEY, or use --judge      \r\n"]
[8.48, "o", " heuristic. \"                                                                   \r\n"]
[8.53, "o", "                 f\"({exc})\",                                                    \r\n"]
[8.58, "o", "                 exc,                                                           \r\n"]
[8.63, "o", "             )                                                                  \r\n"]
[8.68, "o", "         # Parse --metrics flag                                                 \r\n"]
[8.73, "o", "         requested_metrics = {m.strip() for m in metrics.split(\",\") if          \r\n"]
[8.78, "o", " m.strip()}                                                                     \r\n"]
[8.83, "o", "         active_ragas_metrics = None                                            \r\n"]
[8.88, "o", "         if \"ragas\" in requested_metrics:                                       \r\n"]
[8.93, "o", "             from codex_atlas.eval.ragas.factory import make_ragas_metrics      \r\n"]
[8.98, "o", "                                                                                \r\n"]
[9.03, "o", "             active_ragas_metrics = make_ragas_metrics()                        \r\n"]
[9.08, "o", "                                                                                \r\n"]
[9.13, "o", "         results = await run_eval(                                              \r\n"]
[9.18, "o", "             agent,                                                             \r\n"]
[9.23, "o", "             questions,                                                         \r\n"]
[9.28, "o", "             judge=active_judge,                                                \r\n"]
[9.33, "o", "             ragas_metrics=active_ragas_metrics,                                \r\n"]
[9.38, "o", "         )                                                                      \r\n"]
[9.43, "o", "         report = render_report(results)                                        \r\n"]
[9.48, "o", "         out.parent.mkdir(parents=True, exist_ok=True)                          \r\n"]
[9.53, "o", "         out.write_text(report)                                                 \r\n"]
[9.58, "o", "         console.print(f\"[green]wrote[/] {out}\")                                \r\n"]
[9.63, "o", "         if json_out is not None:                                               \r\n"]
[9.68, "o", "             json_out.parent.mkdir(parents=True, exist_ok=True)                 \r\n"]
[9.73, "o", "             json_out.write_text(                                               \r\n"]
[9.78, "o", "                 json.dumps(                                                    \r\n"]
[9.83, "o", "                     [                                                          \r\n"]
[9.88, "o", "                         {                                                      \r\n"]
[9.93, "o", "                             \"qid\": r.qid,                                      \r\n"]
[9.98, "o", "                             \"category\": r.category,                            \r\n"]
[10.03, "o", "                             \"expected_route\": str(r.expected_route),           \r\n"]
[10.08, "o", "                             \"actual_route\": str(r.actual_route),               \r\n"]
[10.13, "o", "                             \"route_correct\": r.route_correct,                  \r\n"]
[10.18, "o", "                             \"citation_recall\": r.citation_recall,              \r\n"]
[10.23, "o", "                             \"citation_precision\": r.citation_precision,        \r\n"]
[10.28, "o", "                             \"latency_ms\": r.latency_ms,                        \r\n"]
[10.33, "o", "                             \"attempts\": r.attempts,                            \r\n"]
[10.38, "o", "                             \"tool_call_count\": r.tool_call_count,              \r\n"]
[10.43, "o", "                             \"cost_estimate_usd\": r.cost_estimate_usd,          \r\n"]
[10.48, "o", "                             \"failure_bucket\": str(r.failure_bucket),           \r\n"]
[10.53, "o", "                             \"cited_qualified_names\": r.cited_qualified_names,  \r\n"]
[10.58, "o", "                         }                                                      \r\n"]
[10.63, "o", "                         for r in results                                       \r\n"]
[10.68, "o", "                     ],                                                         \r\n"]
[10.73, "o", "                     indent=2,                                                  \r\n"]
[10.78, "o", "                 )                                                              \r\n"]
[10.83, "o", "             )                                                                  \r\n"]
[10.88, "o", "             console.print(f\"[green]wrote[/] {json_out}\")                       \r\n"]
[10.93, "o", "         if failure_report is not None:                                         \r\n"]
[10.98, "o", "             write_failure_report(results, failure_report)                      \r\n"]
[11.03, "o", "             console.print(f\"[green]wrote[/] {failure_report}\")                 \r\n"]
[11.08, "o", "         if baseline_out is not None:                                           \r\n"]
[11.13, "o", "             # Write the aggregate metrics as the canonical baseline.           \r\n"]
[11.18, "o", "             # Pin a 5ms absolute slack on latency percentiles so the CI        \r\n"]
[11.23, "o", "             # gate doesn't flag wall-clock jitter on hot CPUs (single-         \r\n"]
[11.28, "o", "             # digit-ms latencies move ~25% from one run to the next).          \r\n"]
[11.33, "o", "             baseline_payload: dict[str, object] = {                            \r\n"]
[11.38, "o", "                 \"_comment\": (                                                  \r\n"]
[11.43, "o", "                     \"Real measurements from the canonical \"                    \r\n"]
[11.48, "o", "                     \"`atlas eval --store=memory` run against the \"             \r\n"]
[11.53, "o", "                     \"bundled corpus. Re-generate after material code \"         \r\n"]
[11.58, "o", "                     \"changes with `atlas eval --store=memory \"                 \r\n"]
[11.63, "o", "                     \"--baseline-out evals/baseline.json`.\"                     \r\n"]
[11.68, "o", "                 ),                                                             \r\n"]
[11.73, "o", "                 \"latency_tolerance_ms\": 5.0,                                   \r\n"]
[11.78, "o", "                 **aggregate(results),                                          \r\n"]
[11.83, "o", "             }                                                                  \r\n"]
[11.88, "o", "             baseline_out.parent.mkdir(parents=True, exist_ok=True)             \r\n"]
[11.93, "o", "             baseline_out.write_text(json.dumps(baseline_payload, indent=2))    \r\n"]
[11.98, "o", "             console.print(f\"[green]wrote[/] {baseline_out}\")                   \r\n"]
[12.03, "o", "         if baseline is not None:                                               \r\n"]
[12.08, "o", "             try:                                                               \r\n"]
[12.13, "o", "                 diff = evaluate_against_baseline(results, baseline,            \r\n"]
[12.18, "o", " tolerance=tolerance)                                                           \r\n"]
[12.23, "o", "             except FileNotFoundError as e:                                     \r\n"]
[12.28, "o", "                 _bail(f\"baseline file not found: {baseline}\", e)               \r\n"]
[12.33, "o", "                 return                                                         \r\n"]
[12.38, "o", "             for metric, (b, c) in diff.regressions.items():                    \r\n"]
[12.43, "o", "                 console.print(f\"[red]regression[/] {metric}: baseline={b:.4f}  \r\n"]
[12.48, "o", " now={c:.4f}\")                                                                  \r\n"]
[12.53, "o", "             for metric, (b, c) in diff.improvements.items():                   \r\n"]
[12.58, "o", "                 console.print(f\"[green]improvement[/] {metric}:                \r\n"]
[12.63, "o", " baseline={b:.4f} now={c:.4f}\")                                                 \r\n"]
[12.68, "o", "             if diff.is_regression:                                             \r\n"]
[12.73, "o", "                 raise typer.Exit(code=2)                                       \r\n"]
[12.78, "o", "         # Print headline so the CLI invocation surfaces the numbers.           \r\n"]
[12.83, "o", "         console.print(report.split(\"## By category\")[0])                       \r\n"]
[12.88, "o", "                                                                                \r\n"]
[12.93, "o", "\r\n"]
[12.98, "o", "codex_atlas.cli.explain._run (src/codex_atlas/cli.py:545-563)                   \r\n"]
[13.03, "o", "\r\n"]
[13.08, "o", "                                                                                \r\n"]
[13.13, "o", "     async def _run() -> None:                                                  \r\n"]
[13.18, "o", "         _require_graph_exists(graph)                                           \r\n"]
[13.23, "o", "         encoder_obj = _resolve_encoder(encoder)                                \r\n"]
[13.28, "o", "         cg = CallGraph.load(graph)                                             \r\n"]
[13.33, "o", "         store = await _open_query_store(                                       \r\n"]
[13.38, "o", "             store_backend=store_backend,                                       \r\n"]
[13.43, "o", "             dim=encoder_obj.dim,                                               \r\n"]
[13.48, "o", "             memory_path=chunks_path,                                           \r\n"]
[13.53, "o", "         )                                                                      \r\n"]
[13.58, "o", "         retriever = Retriever(encoder_obj, store, cg,                          \r\n"]
[13.63, "o", " RetrieverConfig(top_k=8))                                                      \r\n"]
[13.68, "o", "         agent = Agent(retriever)                                               \r\n"]
[13.73, "o", "         result = await agent.run(                                              \r\n"]
[13.78, "o", "             qualified_name,                                                    \r\n"]
[13.83, "o", "             route_override=Route.STRUCTURAL,                                   \r\n"]
[13.88, "o", "         )                                                                      \r\n"]
[13.93, "o", "         console.print(                                                         \r\n"]
[13.98, "o", "             f\"[bold]Route:[/] {result.route} (grade {result.grade:.2f},        \r\n"]
[14.03, "o", " attempts {result.attempts})\"                                                   \r\n"]
[14.08, "o", "         )                                                                      \r\n"]
[14.13, "o", "         console.print(Markdown(result.answer))                                 \r\n"]
[14.18, "o", "                                                                                \r\n"]
[14.23, "o", "\r\n"]
[14.28, "o", "codex_atlas.make_agent (src/codex_atlas/init.py:21-60)                          \r\n"]
[14.33, "o", "\r\n"]
[14.38, "o", "                                                                                \r\n"]
[14.43, "o", " def make_agent(                                                                \r\n"]
[14.48, "o", "     retriever: Retriever,                                                      \r\n"]
[14.53, "o", "     *,                                                                         \r\n"]
[14.58, "o", "     backend: str | None = None,                                                \r\n"]
[14.63, "o", "     config: AgentConfig | None = None,                                         \r\n"]
[14.68, "o", "     tracer: LangfuseTracer | NullTracer | None = None,                         \r\n"]
[14.73, "o", " ) -> Agent | LangGraphAgent:                                                   \r\n"]
[14.78, "o", "     \"\"\"Factory that returns the right agent backend.                           \r\n"]
[14.83, "o", "                                                                                \r\n"]
[14.88, "o", "     Backend selection (first-wins):                                            \r\n"]
[14.93, "o", "     1. ``backend`` argument (``\"hand-rolled\"`` | ``\"langgraph\"``)              \r\n"]
[14.98, "o", "     2. ``ATLAS_AGENT_BACKEND`` env var                                         \r\n"]
[15.03, "o", "     3. Default: ``\"hand-rolled\"`` (the existing ``Agent`` \u2014 no extra deps)     \r\n"]
[15.08, "o", "                                                                                \r\n"]
[15.13, "o", "     The ``\"langgraph\"`` backend requires ``langgraph>=0.2`` to be installed.   \r\n"]
[15.18, "o", "     If it is not, a ``RuntimeError`` is raised with an install hint.           \r\n"]
[15.23, "o", "                                                                                \r\n"]
[15.28, "o", "     Example::                                                                  \r\n"]
[15.33, "o", "                                                                                \r\n"]
[15.38, "o", "         from codex_atlas import make_agent                                     \r\n"]
[15.43, "o", "         agent = make_agent(retriever)                    # hand-rolled         \r\n"]
[15.48, "o", " (default)                                                                      \r\n"]
[15.53, "o", "         agent = make_agent(retriever, backend=\"langgraph\")  # LangGraph        \r\n"]
[15.58, "o", "                                                                                \r\n"]
[15.63, "o", "     Or via env var::                                                           \r\n"]
[15.68, "o", "                                                                                \r\n"]
[15.73, "o", "         ATLAS_AGENT_BACKEND=langgraph uv run atlas ask \"...\"                   \r\n"]
[15.78, "o", "     \"\"\"                                                                        \r\n"]
[15.83, "o", "     resolved = backend or os.environ.get(\"ATLAS_AGENT_BACKEND\", \"hand-rolled\") \r\n"]
[15.88, "o", "     if resolved == \"langgraph\":                                                \r\n"]
[15.93, "o", "         from codex_atlas.agent_langgraph import LangGraphAgent  # noqa:        \r\n"]
[15.98, "o", " PLC0415                                                                        \r\n"]
[16.03, "o", "                                                                                \r\n"]
[16.08, "o", "         return LangGraphAgent(retriever, config=config, tracer=tracer)         \r\n"]
[16.13, "o", "     if resolved in (\"hand-rolled\", \"\"):                                        \r\n"]
[16.18, "o", "         from codex_atlas.agent import Agent  # noqa: PLC0415                   \r\n"]
[16.23, "o", "                                                                                \r\n"]
[16.28, "o", "         return Agent(retriever, config=config, tracer=tracer)                  \r\n"]
[16.33, "o", "     raise RuntimeError(                                                        \r\n"]
[16.38, "o", "         f\"Unknown ATLAS_AGENT_BACKEND {resolved!r}. \"                          \r\n"]
[16.43, "o", "         \"Valid values: 'hand-rolled' (default), 'langgraph'.\"                  \r\n"]
[16.48, "o", "     )                                                                          \r\n"]
[16.53, "o", "                                                                                \r\n"]
[16.58, "o", "\r\n"]
[16.63, "o", "codex_atlas.mcp_server._agent (src/codex_atlas/mcp_server.py:225-276)           \r\n"]
[16.68, "o", "\r\n"]
[16.73, "o", "                                                                                \r\n"]
[16.78, "o", " async def _agent(top_k: int = 8) -> Agent:                                     \r\n"]
[16.83, "o", "     \"\"\"Build an agent for one request, reusing a process-wide store + graph.   \r\n"]
[16.88, "o", "                                                                                \r\n"]
[16.93, "o", "     ``top_k`` is built into the per-request ``RetrieverConfig`` rather         \r\n"]
[16.98, "o", "     than overlaid on a cached agent \u2014 clearer ownership and no shared          \r\n"]
[17.03, "o", "     mutable state across concurrent calls. The expensive bits \u2014 the            \r\n"]
[17.08, "o", "     pgvector connection pool, the encoder, the call graph \u2014 are cached         \r\n"]
[17.13, "o", "     on first use so subsequent requests don't re-run DDL or re-load            \r\n"]
[17.18, "o", "     the graph from disk.                                                       \r\n"]
[17.23, "o", "                                                                                \r\n"]
[17.28, "o", "     Per-step and whole-run timeouts default to                                 \r\n"]
[17.33, "o", "     ``ATLAS_STEP_TIMEOUT_S`` (10 s) and ``ATLAS_RUN_TIMEOUT_S`` (30 s)         \r\n"]
[17.38, "o", "     respectively; set either env var to ``0`` to disable.                      \r\n"]
[17.43, "o", "     \"\"\"                                                                        \r\n"]
[17.48, "o", "     from codex_atlas.store import ChunkStore, InMemoryChunkStore  # noqa:      \r\n"]
[17.53, "o", " PLC0415                                                                        \r\n"]
[17.58, "o", "                                                                                \r\n"]
[17.63, "o", "     global _cached_store, _cached_encoder, _cached_graph  # noqa: PLW0603      \r\n"]
[17.68, "o", "     # Fast path: every cache populated, no lock needed.                        \r\n"]
[17.73, "o", "     if (                                                                       \r\n"]
[17.78, "o", "         _cached_encoder is not None                                            \r\n"]
[17.83, "o", "         and _cached_store is not None                                          \r\n"]
[17.88, "o", "         and _cached_graph is not None                                          \r\n"]
[17.93, "o", "     ):                                                                         \r\n"]
[17.98, "o", "         retriever = Retriever(                                                 \r\n"]
[18.03, "o", "             _cached_encoder,                                                   \r\n"]
[18.08, "o", "             _cached_store,  # type: ignore[arg-type]                           \r\n"]
[18.13, "o", "             _cached_graph,                                                     \r\n"]
[18.18, "o", "             RetrieverConfig(top_k=top_k),                                      \r\n"]
[18.23, "o", "         )                                                                      \r\n"]
[18.28, "o", "         return Agent(retriever, config=_agent_config())                        \r\n"]
[18.33, "o", "     # Cold path: serialise so concurrent first-callers don't each              \r\n"]
[18.38, "o", "     # create a duplicate ChunkStore / pool / graph.                            \r\n"]
[18.43, "o", "     async with _init_lock:                                                     \r\n"]
[18.48, "o", "         if _cached_encoder is None:                                            \r\n"]
[18.53, "o", "             _cached_encoder = _encoder()                                       \r\n"]
[18.58, "o", "         if _cached_store is None:                                              \r\n"]
[18.63, "o", "             backend = _store_backend()                                         \r\n"]
[18.68, "o", "             if backend == \"memory\":                                            \r\n"]
[18.73, "o", "                 _cached_store = await                                          \r\n"]
[18.78, "o", " InMemoryChunkStore.load_from_path(_chunks_path())                              \r\n"]
[18.83, "o", "             else:                                                              \r\n"]
[18.88, "o", "                 store = ChunkStore(dsn=_dsn())                                 \r\n"]
[18.93, "o", "                 await store.setup(dim=_cached_encoder.dim)                     \r\n"]
[18.98, "o", "                 _cached_store = store                                          \r\n"]
[19.03, "o", "         if _cached_graph is None:                                              \r\n"]
[19.08, "o", "             _cached_graph = _graph()                                           \r\n"]
[19.13, "o", "     retriever = Retriever(                                                     \r\n"]
[19.18, "o", "         _cached_encoder,                                                       \r\n"]
[19.23, "o", "         _cached_store,  # type: ignore[arg-type]                               \r\n"]
[19.28, "o", "         _cached_graph,                                                         \r\n"]
[19.33, "o", "         RetrieverConfig(top_k=top_k),                                          \r\n"]
[19.38, "o", "     )                                                                          \r\n"]
[19.43, "o", "     return Agent(retriever, config=_agent_config())                            \r\n"]
[19.48, "o", "                                                                                \r\n"]
[19.53, "o", "                                   Citations                                    \r\n"]
[19.58, "o", "\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n"]
[19.63, "o", "\u2503 Symbol                        \u2503 File                               \u2503 Lines   \u2503\r\n"]
