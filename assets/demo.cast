[28.465, "o", "\r\n"]
[28.515, "o", "                                                                                \r\n"]
[28.565, "o", "     async def _node_retrieve(self, state: _LGState) -> _LGState:               \r\n"]
[28.615, "o", "         t0 = time.perf_counter()                                               \r\n"]
[28.665, "o", "         retrieval = await self._retriever.retrieve(                            \r\n"]
[28.715, "o", "             state.query, route_override=state.route_override                   \r\n"]
[28.765, "o", "         )                                                                      \r\n"]
[28.815, "o", "         state.retrieval = retrieval                                            \r\n"]
[28.865, "o", "         elapsed = (time.perf_counter() - t0) * 1000.0                          \r\n"]
[28.915, "o", "         state.trace.append(                                                    \r\n"]
[28.965, "o", "             TraceEvent(                                                        \r\n"]
[29.015, "o", "                 node=Node.CLASSIFY,                                            \r\n"]
[29.065, "o", "                 started_at=t0,                                                 \r\n"]
[29.115, "o", "                 elapsed_ms=0.0,                                                \r\n"]
[29.165, "o", "                 detail=f\"route={retrieval.route}                               \r\n"]
[29.215, "o", " confidence={retrieval.confidence:.2f}\",                                        \r\n"]
[29.265, "o", "             )                                                                  \r\n"]
[29.315, "o", "         )                                                                      \r\n"]
[29.365, "o", "         state.trace.append(                                                    \r\n"]
[29.415, "o", "             TraceEvent(                                                        \r\n"]
[29.465, "o", "                 node=Node.RETRIEVE,                                            \r\n"]
[29.515, "o", "                 started_at=t0,                                                 \r\n"]
[29.565, "o", "                 elapsed_ms=elapsed,                                            \r\n"]
[29.615, "o", "                 detail=(                                                       \r\n"]
[29.665, "o", "                     f\"chunks={len(retrieval.chunks)} \"                         \r\n"]
[29.715, "o", "                     f\"extras={len(retrieval.extra_qualified_names)}\"           \r\n"]
[29.765, "o", "                 ),                                                             \r\n"]
[29.815, "o", "             )                                                                  \r\n"]
[29.865, "o", "         )                                                                      \r\n"]
[29.915, "o", "         state.tool_calls.append(                                               \r\n"]
[29.965, "o", "             ToolCall(                                                          \r\n"]
[30.015, "o", "                 query=state.query,                                             \r\n"]
[30.065, "o", "                 route=retrieval.route,                                         \r\n"]
[30.115, "o", "                 n_chunks=len(retrieval.chunks),                                \r\n"]
[30.165, "o", "                 elapsed_ms=elapsed,                                            \r\n"]
[30.215, "o", "                 confidence=retrieval.confidence,                               \r\n"]
[30.265, "o", "             )                                                                  \r\n"]
[30.315, "o", "         )                                                                      \r\n"]
[30.365, "o", "         return state                                                           \r\n"]
[30.415, "o", "                                                                                \r\n"]
[30.465, "o", "\r\n"]
[30.515, "o", "codex_atlas.cli.search._run (src/codex_atlas/cli.py:452-503)                    \r\n"]
[30.565, "o", "\r\n"]
[30.615, "o", "                                                                                \r\n"]
[30.665, "o", "     async def _run() -> None:                                                  \r\n"]
[30.715, "o", "         _require_graph_exists(graph)                                           \r\n"]
[30.765, "o", "         encoder_obj = _resolve_encoder(encoder)                                \r\n"]
[30.815, "o", "         cg = CallGraph.load(graph)                                             \r\n"]
[30.865, "o", "         store = await _open_query_store(                                       \r\n"]
[30.915, "o", "             store_backend=store_backend,                                       \r\n"]
[30.965, "o", "             dim=encoder_obj.dim,                                               \r\n"]
[31.015, "o", "             memory_path=chunks_path,                                           \r\n"]
[31.065, "o", "         )                                                                      \r\n"]
[31.115, "o", "         retriever = Retriever(encoder_obj, store, cg,                          \r\n"]
[31.165, "o", " RetrieverConfig(top_k=top_k))                                                  \r\n"]
[31.215, "o", "         result = await retriever.retrieve(query)                               \r\n"]
[31.265, "o", "         if output_format == \"json\":                                            \r\n"]
[31.315, "o", "             sys.stdout.write(                                                  \r\n"]
[31.365, "o", "                 json.dumps(                                                    \r\n"]
[31.415, "o", "                     {                                                          \r\n"]
[31.465, "o", "                         \"route\": str(result.route),                            \r\n"]
[31.515, "o", "                         \"confidence\": result.confidence,                       \r\n"]
[31.565, "o", "                         \"signals\": result.signals,                             \r\n"]
[31.615, "o", "                         \"chunks\": [                                            \r\n"]
[31.665, "o", "                             {                                                  \r\n"]
[31.715, "o", "                                 \"qualified_name\": c.qualified_name,            \r\n"]
[31.765, "o", "                                 \"file_path\": c.file_path,                      \r\n"]
[31.815, "o", "                                 \"lineno_start\": c.lineno_start,                \r\n"]
[31.865, "o", "                                 \"lineno_end\": c.lineno_end,                    \r\n"]
[31.915, "o", "                                 \"score\": c.score,                              \r\n"]
[31.965, "o", "                             }                                                  \r\n"]
[32.015, "o", "                             for c in result.chunks                             \r\n"]
[32.065, "o", "                         ],                                                     \r\n"]
[32.115, "o", "                         \"extra_qualified_names\": result.extra_qualified_names, \r\n"]
[32.165, "o", "                     },                                                         \r\n"]
[32.215, "o", "                     indent=2,                                                  \r\n"]
[32.265, "o", "                 )                                                              \r\n"]
[32.315, "o", "                 + \"\\n\"                                                         \r\n"]
[32.365, "o", "             )                                                                  \r\n"]
[32.415, "o", "             return                                                             \r\n"]
[32.465, "o", "         console.print(f\"[bold]Route:[/] {result.route} (confidence             \r\n"]
[32.515, "o", " {result.confidence:.2f})\")                                                     \r\n"]
[32.565, "o", "         if not result.chunks:                                                  \r\n"]
[32.615, "o", "             console.print(\"[yellow]no chunks[/]\")                              \r\n"]
[32.665, "o", "             return                                                             \r\n"]
[32.715, "o", "         t = Table(title=\"Top chunks\")                                          \r\n"]
[32.765, "o", "         t.add_column(\"Symbol\")                                                 \r\n"]
[32.815, "o", "         t.add_column(\"File\")                                                   \r\n"]
[32.865, "o", "         t.add_column(\"Lines\")                                                  \r\n"]
[32.915, "o", "         t.add_column(\"Score\")                                                  \r\n"]
[32.965, "o", "         for c in result.chunks:                                                \r\n"]
[33.015, "o", "             t.add_row(                                                         \r\n"]
[33.065, "o", "                 c.qualified_name,                                              \r\n"]
[33.115, "o", "                 c.file_path,                                                   \r\n"]
[33.165, "o", "                 f\"{c.lineno_start}-{c.lineno_end}\",                            \r\n"]
[33.215, "o", "                 f\"{c.score:.3f}\",                                              \r\n"]
[33.265, "o", "             )                                                                  \r\n"]
[33.315, "o", "         console.print(t)                                                       \r\n"]
[33.365, "o", "                                                                                \r\n"]
[33.415, "o", "\r\n"]
[33.465, "o", "codex_atlas.retriever.Retriever._hybrid (src/codex_atlas/retriever.py:351-414)  \r\n"]
[33.515, "o", "\r\n"]
[33.565, "o", "                                                                                \r\n"]
[33.615, "o", "     async def _hybrid(self, query: str) -> tuple[list[StoredChunk],            \r\n"]
[33.665, "o", " list[str]]:                                                                    \r\n"]
[33.715, "o", "         # Stage 1: vector top-k for the seed. Stage 2: graph neighbours        \r\n"]
[33.765, "o", "         # up to ``graph_depth`` hops, with per-node hop counts so the          \r\n"]
[33.815, "o", "         # scorer can decay 2-hop neighbours below 1-hop neighbours.            \r\n"]
[33.865, "o", "         # Stage 3: rank the union with ``hybrid_score`` so cosine, graph       \r\n"]
[33.915, "o", "         # proximity, and term overlap all contribute \u2014 otherwise the           \r\n"]
[33.965, "o", "         # seed-then-append order produced by stages 1+2 would dominate         \r\n"]
[34.015, "o", "         # even when an expanded neighbour is a better match. We keep the       \r\n"]
[34.065, "o", "         # discovery-order ``expansions`` list as the auxiliary \"extras\"        \r\n"]
[34.115, "o", "         # return so the agent can still see the neighbour names,               \r\n"]
[34.165, "o", "         # irrespective of the ranking cut.                                     \r\n"]
[34.215, "o", "         seed = await self._vector_topk(query, self._config.top_k)              \r\n"]
[34.265, "o", "         seed_qnames = {c.qualified_name for c in seed}                         \r\n"]
[34.315, "o", "         graph_distances: dict[str, int] = dict.fromkeys(seed_qnames, 0)        \r\n"]
[34.365, "o", "         expansions: list[str] = []                                             \r\n"]
[34.415, "o", "         seen = set(seed_qnames)                                                \r\n"]
[34.465, "o", "         for c in seed:                                                         \r\n"]
[34.515, "o", "             depths = self._graph.neighbors_with_depth(                         \r\n"]
[34.565, "o", "                 c.qualified_name, depth=self._config.graph_depth               \r\n"]
[34.615, "o", "             )                                                                  \r\n"]
[34.665, "o", "             # Walk neighbours in increasing-hop order so the discovery         \r\n"]
[34.715, "o", "             # list reflects hop ordering and ``graph_distances`` records       \r\n"]
[34.765, "o", "             # the *minimum* observed depth across multiple seed paths.         \r\n"]
[34.815, "o", "             for neighbour, hop in sorted(depths.items(), key=lambda t: t[1]):  \r\n"]
[34.865, "o", "                 if neighbour not in seen:                                      \r\n"]
[34.915, "o", "                     expansions.append(neighbour)                               \r\n"]
[34.965, "o", "                     seen.add(neighbour)                                        \r\n"]
[35.015, "o", "                 existing = graph_distances.get(neighbour)                      \r\n"]
[35.065, "o", "                 if existing is None or hop < existing:                         \r\n"]
[35.115, "o", "                     graph_distances[neighbour] = hop                           \r\n"]
[35.165, "o", "         # Materialise the expansions so the ranker sees real chunk text.       \r\n"]
[35.215, "o", "         candidates: list[StoredChunk] = list(seed)                             \r\n"]
[35.265, "o", "         for q in expansions[: self._config.top_k]:                             \r\n"]
[35.315, "o", "             extra = await self._store.fetch_by_qualified_name(q)               \r\n"]
[35.365, "o", "             if extra is not None:                                              \r\n"]
[35.415, "o", "                 candidates.append(extra)                                       \r\n"]
[35.465, "o", "         weights = (                                                            \r\n"]
[35.515, "o", "             self._config.hybrid_weight_cosine,                                 \r\n"]
[35.565, "o", "             self._config.hybrid_weight_graph,                                  \r\n"]
[35.615, "o", "             self._config.hybrid_weight_fulltext,                               \r\n"]
[35.665, "o", "         )                                                                      \r\n"]
[35.715, "o", "         scored = hybrid_score(                                                 \r\n"]
[35.765, "o", "             candidates,                                                        \r\n"]
[35.815, "o", "             query=query,                                                       \r\n"]
[35.865, "o", "             seeds=seed_qnames,                                                 \r\n"]
[35.915, "o", "             graph_distances=graph_distances,                                   \r\n"]
[35.965, "o", "             weights=weights,                                                   \r\n"]
[36.015, "o", "         )                                                                      \r\n"]
[36.065, "o", "         # Rebuild the candidate list in scored order AND swap each             \r\n"]
[36.115, "o", "         # chunk's ``score`` for the blended hybrid score the route             \r\n"]
[36.165, "o", "         # actually used to rank. Returning the original ``StoredChunk``        \r\n"]
[36.215, "o", "         # leaked the raw cosine (or the ``0.0`` graph-only sentinel) at        \r\n"]
[36.265, "o", "         # the MCP/CLI boundary even though ranking happened on the             \r\n"]
[36.315, "o", "         # combined score \u2014 citations could not surface the real route          \r\n"]
[36.365, "o", "         # confidence and downstream re-rankers received the wrong              \r\n"]
[36.415, "o", "         # signal.                                                              \r\n"]
[36.465, "o", "         by_qname = {c.qualified_name: c for c in candidates}                   \r\n"]
[36.515, "o", "         ranked: list[StoredChunk] = []                                         \r\n"]
[36.565, "o", "         for s in scored:                                                       \r\n"]
[36.615, "o", "             base = by_qname.get(s.qualified_name)                              \r\n"]
[36.665, "o", "             if base is None:                                                   \r\n"]
[36.715, "o", "                 continue                                                       \r\n"]
[36.765, "o", "             ranked.append(replace(base, score=s.combined))                     \r\n"]
[36.815, "o", "         return ranked[: self._config.top_k], expansions                        \r\n"]
[36.865, "o", "                                                                                \r\n"]
[36.915, "o", "\r\n"]
[36.965, "o", "codex_atlas.retriever.Retriever._import_chain                                   \r\n"]
[37.015, "o", "(src/codex_atlas/retriever.py:455-465)                                          \r\n"]
[37.065, "o", "\r\n"]
[37.115, "o", "                                                                                \r\n"]
[37.165, "o", "     async def _import_chain(self, query: str) -> tuple[list[StoredChunk],      \r\n"]
[37.215, "o", " list[str]]:                                                                    \r\n"]
[37.265, "o", "         target = _extract_qualified_name(query, self._graph)                   \r\n"]
[37.315, "o", "         if target is None:                                                     \r\n"]
[37.365, "o", "             return await self._vector_topk(query, self._config.top_k), []      \r\n"]
[37.415, "o", "         chain = self._graph.import_chain(target,                               \r\n"]
[37.465, "o", " max_depth=self._config.import_chain_max_depth)                                 \r\n"]
[37.515, "o", "         chunks: list[StoredChunk] = []                                         \r\n"]
[37.565, "o", "         for q in chain[: self._config.top_k]:                                  \r\n"]
[37.615, "o", "             sc = await self._store.fetch_by_qualified_name(q)                  \r\n"]
[37.665, "o", "             if sc is not None:                                                 \r\n"]
[37.715, "o", "                 chunks.append(sc)                                              \r\n"]
[37.765, "o", "         return chunks, chain                                                   \r\n"]
[37.815, "o", "                                                                                \r\n"]
[37.865, "o", "\r\n"]
