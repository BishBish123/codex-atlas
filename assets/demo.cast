[19.78, "o", "\u2502 codex_atlas.cli.explain._run  \u2502 /Users/bisharamekhaeil/projects/c\u2026 \u2502 545-563 \u2502\r\n"]
[19.83, "o", "\u2502 codex_atlas.make_agent        \u2502 /Users/bisharamekhaeil/projects/c\u2026 \u2502 21-60   \u2502\r\n"]
[19.88, "o", "\u2502 codex_atlas.mcp_server._agent \u2502 /Users/bisharamekhaeil/projects/c\u2026 \u2502 225-276 \u2502\r\n"]
[19.93, "o", "\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
