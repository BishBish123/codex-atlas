[25.765, "o", "Route: structural (grade 1.00, attempts 1)\r\n"]
[25.815, "o", "                    codex_atlas.retriever.Retriever.retrieve                    \r\n"]
[25.865, "o", "\r\n"]
[25.915, "o", "codex_atlas.agent.Agent._retrieve (src/codex_atlas/agent.py:696-736)            \r\n"]
[25.965, "o", "\r\n"]
[26.015, "o", "                                                                                \r\n"]
[26.065, "o", "     async def _retrieve(self, state: _State) -> None:                          \r\n"]
[26.115, "o", "         t0 = time.perf_counter()                                               \r\n"]
[26.165, "o", "         state.in_flight_node = Node.RETRIEVE                                   \r\n"]
[26.215, "o", "         retrieval = await self._with_step_deadline(                            \r\n"]
[26.265, "o", "             self._retriever.retrieve(state.query,                              \r\n"]
[26.315, "o", " route_override=state.route_override)                                           \r\n"]
[26.365, "o", "         )                                                                      \r\n"]
[26.415, "o", "         state.retrieval = retrieval                                            \r\n"]
[26.465, "o", "         elapsed = (time.perf_counter() - t0) * 1000.0                          \r\n"]
[26.515, "o", "         state.trace.append(                                                    \r\n"]
[26.565, "o", "             TraceEvent(                                                        \r\n"]
[26.615, "o", "                 node=Node.CLASSIFY,                                            \r\n"]
[26.665, "o", "                 started_at=t0,                                                 \r\n"]
[26.715, "o", "                 elapsed_ms=0.0,                                                \r\n"]
[26.765, "o", "                 detail=f\"route={retrieval.route}                               \r\n"]
[26.815, "o", " confidence={retrieval.confidence:.2f}\",                                        \r\n"]
[26.865, "o", "             )                                                                  \r\n"]
[26.915, "o", "         )                                                                      \r\n"]
[26.965, "o", "         state.trace.append(                                                    \r\n"]
[27.015, "o", "             TraceEvent(                                                        \r\n"]
[27.065, "o", "                 node=Node.RETRIEVE,                                            \r\n"]
[27.115, "o", "                 started_at=t0,                                                 \r\n"]
[27.165, "o", "                 elapsed_ms=elapsed,                                            \r\n"]
[27.215, "o", "                 detail=(                                                       \r\n"]
[27.265, "o", "                     f\"chunks={len(retrieval.chunks)}                           \r\n"]
[27.315, "o", " extras={len(retrieval.extra_qualified_names)}\"                                 \r\n"]
[27.365, "o", "                 ),                                                             \r\n"]
[27.415, "o", "             )                                                                  \r\n"]
[27.465, "o", "         )                                                                      \r\n"]
[27.515, "o", "         state.tool_calls.append(                                               \r\n"]
[27.565, "o", "             ToolCall(                                                          \r\n"]
[27.615, "o", "                 query=state.query,                                             \r\n"]
[27.665, "o", "                 route=retrieval.route,                                         \r\n"]
[27.715, "o", "                 n_chunks=len(retrieval.chunks),                                \r\n"]
[27.765, "o", "                 elapsed_ms=elapsed,                                            \r\n"]
[27.815, "o", "                 confidence=retrieval.confidence,                               \r\n"]
[27.865, "o", "             )                                                                  \r\n"]
[27.915, "o", "         )                                                                      \r\n"]
[27.965, "o", "         # Clear the in-flight marker so a deadline tripping BETWEEN this       \r\n"]
[28.015, "o", "         # node and the next does not surface a stale phase via                 \r\n"]
[28.065, "o", "         # ``cancelled_node``. A timeout fired by ``_with_run_deadline``        \r\n"]
[28.115, "o", "         # before the next node sets the marker should report ``None``          \r\n"]
[28.165, "o", "         # (idle), not ``Node.RETRIEVE``.                                       \r\n"]
[28.215, "o", "         state.in_flight_node = None                                            \r\n"]
[28.265, "o", "                                                                                \r\n"]
[28.315, "o", "\r\n"]
[28.365, "o", "codex_atlas.agent_langgraph.LangGraphAgent._node_retrieve                       \r\n"]
